<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <PreferenceCategory android:title="@string/preference_category_general">

        <DropDownPreference
            android:defaultValue="-1"
            android:entries="@array/theme_texts"
            android:entryValues="@array/theme_values"
            android:icon="@drawable/ic_dark_mode"
            android:key="dark_theme"
            android:summary="%s"
            android:title="@string/dark_theme" />

        <DropDownPreference
            android:title="Map"
            android:summary="%s"
            android:icon="@drawable/ic_map_type"
            android:key="map_type"
            android:dialogTitle="Map type"
            android:entries="@array/map_type"
            android:entryValues="@array/map_value"
            android:defaultValue="1" />

        <Preference
            android:title="@string/enable_joystick"
            android:summary="@string/enable_joystick_summary"
            android:icon="@drawable/ic_joystick"
            android:key="joystick_enabled"
            android:defaultValue="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/xposed">

        <SwitchPreferenceCompat
            android:title="@string/advanced_hook"
            android:summary="@string/advanced_summary"
            android:key="system_hooked"
            android:icon="@drawable/ic_advanced_hook"
            android:widgetLayout="@layout/preference_switch_widget"
        />

        <Preference
            android:key="pref_gps_accuracy"
            android:title="@string/pref_gps_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_network_accuracy"
            android:title="@string/pref_network_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_fused_accuracy"
            android:title="@string/pref_fused_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_altitude"
            android:title="@string/pref_altitude"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_speed"
            android:title="@string/pref_speed"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_horizontal_accuracy"
            android:title="@string/pref_horizontal_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_vertical_accuracy"
            android:title="@string/pref_vertical_accuracy"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_msl"
            android:title="@string/pref_msl"
            android:icon="@drawable/ic_accuracy"
            android:persistent="false" />

        <Preference
            android:key="pref_random_radius"
            android:title="@string/pref_random_radius"
            android:icon="@drawable/ic_random_position"
            android:persistent="false" />

        <Preference
            android:key="pref_random_interval"
            android:title="@string/pref_random_interval"
            android:icon="@drawable/ic_random_position"
            android:persistent="false" />

    </PreferenceCategory>

</PreferenceScreen>